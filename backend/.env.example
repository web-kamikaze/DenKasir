PROJECT_NAME="DenKasir Server API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="denkasir_super_secret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Database PostgreSQL
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="denkasir_db"
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/denkasir_db"
SYNC_DATABASE_URL="postgresql://postgres:password@localhost:5432/denkasir_db"
