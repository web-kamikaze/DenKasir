<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvFlowBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MASUK"
            android:textColor="#059669"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_cepat"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvFlowCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PENJUALAN"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@id/tvFlowBadge"
            app:layout_constraintTop_toTopOf="@id/tvFlowBadge"
            app:layout_constraintBottom_toBottomOf="@id/tvFlowBadge" />

        <TextView
            android:id="@+id/tvFlowDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="05 Sep 2026, 08:00"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvFlowDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Penjualan Kasir No. TRX-20260905-001 (CASH)"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvFlowAmount"
            app:layout_constraintTop_toBottomOf="@id/tvFlowBadge" />

        <TextView
            android:id="@+id/tvFlowAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+Rp 43.500"
            android:textColor="#059669"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/tvFlowDescription" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
