<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvHistProductName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nama Produk"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHistDiffBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selisih -2"
                android:textColor="#DC2626"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_selisih"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvHistDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sistem: 10 • Fisik: 8 (Alasan: Rusak)"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvHistTimestamp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="01 Nov 2026, 14:30"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
