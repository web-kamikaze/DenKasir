<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Catat Hutang / Piutang Usaha"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kelola piutang kasbon pelanggan atau hutang toko ke supplier"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="2dp" />

        <!-- Jenis: PIUTANG (Pelanggan) vs HUTANG (Supplier) -->
        <RadioGroup
            android:id="@+id/rgDebtType"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <RadioButton
                android:id="@+id/rbPiutang"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Piutang (Kasbon Pelanggan)"
                android:textColor="#3E24E2"
                android:textStyle="bold"
                android:checked="true"
                android:buttonTint="#3E24E2" />

            <RadioButton
                android:id="@+id/rbHutang"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Hutang (Ke Supplier)"
                android:textColor="#D97706"
                android:textStyle="bold"
                android:buttonTint="#D97706" />
        </RadioGroup>

        <!-- Nama Pelanggan / Supplier -->
        <TextView
            android:id="@+id/tvPartyNameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Nama Pelanggan / Peminjam"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#334155" />

        <EditText
            android:id="@+id/etPartyName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_box"
            android:paddingHorizontal="14dp"
            android:hint="Contoh: Pak Joko (Bengkel)"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:singleLine="true" />

        <!-- No HP / WhatsApp -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Nomor WhatsApp / HP"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#334155" />

        <EditText
            android:id="@+id/etPartyPhone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_box"
            android:paddingHorizontal="14dp"
            android:hint="Contoh: 081234567890"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:inputType="phone"
            android:singleLine="true" />

        <!-- Total Hutang / Piutang (Rp) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Total Nominal (Rp)"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#334155" />

        <EditText
            android:id="@+id/etTotalDebtAmount"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_box"
            android:paddingHorizontal="14dp"
            android:hint="Contoh: 75000"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:inputType="number"
            android:singleLine="true" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelDebt"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Batal"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                app:backgroundTint="@color/purple_button_light"
                app:cornerRadius="12dp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveDebt"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3"
                android:text="Simpan Catatan"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                app:backgroundTint="#3E24E2"
                app:cornerRadius="12dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>