<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buat Akun / Kategori BKU Baru"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tambahkan pos akun keuangan baru untuk pencatatan buku kas"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="2dp" />

        <!-- Tipe Akun: Pemasukan vs Pengeluaran -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Klasifikasi Akun"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#334155" />

        <RadioGroup
            android:id="@+id/rgAccountType"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <RadioButton
                android:id="@+id/rbAccIn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Pemasukan (IN)"
                android:textColor="#059669"
                android:textStyle="bold"
                android:checked="true"
                android:buttonTint="#059669" />

            <RadioButton
                android:id="@+id/rbAccOut"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Pengeluaran (OUT)"
                android:textColor="#DC2626"
                android:textStyle="bold"
                android:buttonTint="#DC2626" />
        </RadioGroup>

        <!-- Nama Akun -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Nama Akun Keuangan"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#334155" />

        <EditText
            android:id="@+id/etAccountName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_box"
            android:paddingHorizontal="14dp"
            android:hint="Contoh: Biaya Perawatan Mesin / Titipan"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:singleLine="true" />

        <!-- Kode Akun (Opsional) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Kode Akun / Nomor Rekening BKU"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#334155" />

        <EditText
            android:id="@+id/etAccountCode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_box"
            android:paddingHorizontal="14dp"
            android:hint="Contoh: 5-1011"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:singleLine="true" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelCreateAccount"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Batal"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                app:backgroundTint="@color/purple_button_light"
                app:cornerRadius="12dp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveAccount"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3"
                android:text="Simpan Akun"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                app:backgroundTint="#3E24E2"
                app:cornerRadius="12dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>