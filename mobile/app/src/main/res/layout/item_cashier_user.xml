<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_role_badge_kasir">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_cash_register"
                app:tint="#0284C7" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCashierFullName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Kasir Utama" />

            <TextView
                android:id="@+id/tvCashierUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                tools:text="@kasir_1" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCashierRoleTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KASIR"
            android:textColor="#0369A1"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_role_badge_kasir" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
