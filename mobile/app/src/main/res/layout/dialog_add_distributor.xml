<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tambah Rute Distributor Khusus"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Setiap kategori produk bisa memiliki SMS Center dan PIN yang berbeda"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="2dp" />

        <!-- 1. Nama Distributor -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nama Distributor / Server"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#334155" />

        <EditText
            android:id="@+id/etDistributorName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_box"
            android:paddingHorizontal="14dp"
            android:hint="Contoh: Server Pulsa Murah (Distributor 1)"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:singleLine="true" />

        <!-- 2. Kategori Layanan Target -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Kategori Layanan yang Ditangani"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#334155" />

        <Spinner
            android:id="@+id/spDistributorCategory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_box"
            android:paddingHorizontal="12dp" />

        <!-- 3. Nomor SMS Center Distributor -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Nomor SMS Center Distributor"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#334155" />

        <EditText
            android:id="@+id/etDistributorCenter"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_box"
            android:paddingHorizontal="14dp"
            android:hint="Contoh: 081234567890"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:inputType="phone"
            android:singleLine="true" />

        <!-- 4. PIN Distributor Ini -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="PIN Transaksi Distributor Ini"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#334155" />

        <EditText
            android:id="@+id/etDistributorPin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_box"
            android:paddingHorizontal="14dp"
            android:hint="Contoh: 1234"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:inputType="numberPassword"
            android:singleLine="true" />

        <!-- 5. Format Perintah SMS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Format Perintah SMS Server Ini"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#334155" />

        <RadioGroup
            android:id="@+id/rgDistributorFormat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbFormatDot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="[KODE].[TUJUAN].[PIN] (Pemisah Titik)"
                android:textSize="12sp"
                android:textColor="#0F172A"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbFormatHash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="[KODE]#[TUJUAN]#[PIN] (Pemisah Pagar)"
                android:textSize="12sp"
                android:textColor="#0F172A" />

            <RadioButton
                android:id="@+id/rbFormatSpace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BELI [KODE] [TUJUAN] [PIN] (Pemisah Spasi)"
                android:textSize="12sp"
                android:textColor="#0F172A" />
        </RadioGroup>

        <!-- Pilihan Kartu SIM untuk Distributor Ini -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Pilihan Kartu SIM Pengirim (Dual SIM)"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#334155" />

        <RadioGroup
            android:id="@+id/rgDistributorSim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbDistSimDefault"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ikuti Pengaturan Utama (Otomatis)"
                android:textSize="12sp"
                android:textColor="#0F172A"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbDistSim1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wajib Lewat SIM 1"
                android:textSize="12sp"
                android:textColor="#0F172A" />

            <RadioButton
                android:id="@+id/rbDistSim2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wajib Lewat SIM 2"
                android:textSize="12sp"
                android:textColor="#0F172A" />
        </RadioGroup>

        <!-- Preview Kotak -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F1F5F9"
            android:padding="10dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pratinjau Perintah ke Distributor Ini:"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#475569" />

            <TextView
                android:id="@+id/tvDistributorPreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="S10.081234567890.1234"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#3E24E2"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelDistributor"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Batal"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                app:backgroundTint="@color/purple_button_light"
                app:cornerRadius="12dp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveDistributor"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3"
                android:text="Simpan Distributor"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                app:backgroundTint="#3E24E2"
                app:cornerRadius="12dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
