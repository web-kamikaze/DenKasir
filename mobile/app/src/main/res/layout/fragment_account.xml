<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_screen">

    <!-- Header Gradient Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/bg_header_gradient"
        android:paddingHorizontal="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pengaturan &amp; Akun"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ========================================== -->
            <!-- CARD 1: USER ACCOUNT & ROLE SESSION        -->
            <!-- ========================================== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- User Avatar Circle -->
                        <FrameLayout
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_role_badge_owner">

                            <ImageView
                                android:id="@+id/ivUserAvatar"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_person"
                                app:tint="#3E24E2" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvUserFullName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pemilik Toko (Owner)"
                                android:textColor="#0F172A"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="3dp">

                                <TextView
                                    android:id="@+id/tvUserRoleBadge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="OWNER"
                                    android:textColor="#3E24E2"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:background="@drawable/bg_role_badge_owner" />

                                <TextView
                                    android:id="@+id/tvUsername"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="@owner"
                                    android:textColor="#64748B"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Switch / Ganti Akun Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSwitchRole"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:text="Ganti Akun"
                            android:textColor="#3E24E2"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:icon="@drawable/ic_switch_user"
                            app:iconTint="#3E24E2"
                            app:backgroundTint="#EBEDFE"
                            app:cornerRadius="10dp"
                            app:elevation="0dp" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ========================================== -->
            <!-- CARD 2: STORE PROFILE (KELOLA TOKO)        -->
            <!-- ========================================== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Section Header & Edit Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_store_front"
                            app:tint="#3E24E2" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Informasi Toko"
                            android:textColor="#0F172A"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- Edit Button (Only active for OWNER) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEditStoreProfile"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Ubah Profil"
                            android:textColor="@android:color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:icon="@drawable/ic_edit_pen"
                            app:iconTint="@android:color/white"
                            app:backgroundTint="#3E24E2"
                            app:cornerRadius="10dp"
                            app:elevation="1dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9"
                        android:layout_marginVertical="12dp" />

                    <!-- Store Name -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_store_front"
                            app:tint="#94A3B8" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nama Toko / UMKM"
                                android:textColor="#64748B"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvStoreNameVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DENKASIR UMKM"
                                android:textColor="#0F172A"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Store Address -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_location_pin"
                            app:tint="#94A3B8" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Alamat Toko"
                                android:textColor="#64748B"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvStoreAddressVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Jl. Pemuda No. 88, Semarang"
                                android:textColor="#0F172A"
                                android:textSize="13sp"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Store Phone / Contact -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_phone_contact"
                            app:tint="#94A3B8" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Kontak Toko / WhatsApp"
                                android:textColor="#64748B"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvStorePhoneVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="081234567890"
                                android:textColor="#0F172A"
                                android:textSize="13sp"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Lock Banner for Kasir Role -->
                    <LinearLayout
                        android:id="@+id/layoutKasirLockBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="#FEF2F2"
                        android:padding="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_lock_closed"
                            app:tint="#EF4444" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Anda masuk sebagai KASIR. Hanya akun OWNER yang dapat mengubah informasi toko."
                            android:textColor="#DC2626"
                            android:textSize="11sp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ========================================== -->
            <!-- SECTION: PENGATURAN OPERASIONAL & PERANGKAT-->
            <!-- ========================================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pengaturan Perangkat &amp; Sistem"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBluetoothPrinter"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Koneksi Printer Bluetooth Thermal"
                android:textColor="@color/text_primary"
                android:gravity="start|center_vertical"
                app:icon="@drawable/ic_printer_machine"
                app:iconTint="#3E24E2"
                app:backgroundTint="@android:color/white"
                app:cornerRadius="12dp"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp" />

                        <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageCashiers"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Kelola Akun Kasir / Tambah Kasir"
                android:textColor="@color/text_primary"
                android:gravity="start|center_vertical"
                app:icon="@drawable/ic_person"
                app:iconTint="#3E24E2"
                app:backgroundTint="@android:color/white"
                app:cornerRadius="12dp"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp"
                android:layout_marginTop="8dp" />
                        <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStockAlertRule"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Aturan Batas Minimum Stok &amp; Notif Draft"
                android:textColor="@color/text_primary"
                android:gravity="start|center_vertical"
                app:icon="@drawable/ic_scale_weight"
                app:iconTint="#3E24E2"
                app:backgroundTint="@android:color/white"
                app:cornerRadius="12dp"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp"
                android:layout_marginTop="8dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnH2HConfig"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Pengaturan Server Pulsa H2H / OtomaX"
                android:textColor="@color/text_primary"
                android:gravity="start|center_vertical"
                app:icon="@drawable/ic_pulsa"
                app:iconTint="#3E24E2"
                app:backgroundTint="@android:color/white"
                app:cornerRadius="12dp"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp"
                android:layout_marginTop="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloudSync"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Sinkronisasi Data ke Server Cloud"
                android:textColor="@color/text_primary"
                android:gravity="start|center_vertical"
                app:icon="@drawable/ic_download_file"
                app:iconTint="#3E24E2"
                app:backgroundTint="@android:color/white"
                app:cornerRadius="12dp"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp"
                android:layout_marginTop="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackupRestore"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Backup &amp; Restore Database (.db / .xlsx)"
                android:textColor="@color/text_primary"
                android:gravity="start|center_vertical"
                app:icon="@drawable/ic_spreadsheet_file"
                app:iconTint="#3E24E2"
                app:backgroundTint="@android:color/white"
                app:cornerRadius="12dp"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>