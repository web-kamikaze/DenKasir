<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvPayDebtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pelunasan / Cicil Pembayaran"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvPayDebtSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Catat penerimaan kas masuk atau pembayaran hutang"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="2dp" />

        <!-- Info Card: Sisa Tagihan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F8FAFC"
            android:padding="14dp"
            android:layout_marginTop="14dp">

            <TextView
                android:id="@+id/tvTargetPartyName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ibu Siti (Warga RT 03)"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sisa Tagihan:"
                    android:textColor="#64748B"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvRemainingAmountDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp 100.000"
                    android:textColor="#DC2626"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Jumlah Bayar (Rp) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Jumlah Pembayaran Diterima (Rp)"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#334155" />

        <EditText
            android:id="@+id/etPaymentAmount"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_box"
            android:paddingHorizontal="14dp"
            android:hint="Contoh: 50000"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:inputType="number"
            android:singleLine="true" />

        <!-- Tombol Bayar Lunas Cepat -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuickPayFull"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Bayar Lunas Semua"
            android:textColor="#3E24E2"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="#EBEDFE"
            app:cornerRadius="8dp"
            app:elevation="0dp"
            android:layout_marginTop="8dp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelPayment"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Batal"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                app:backgroundTint="@color/purple_button_light"
                app:cornerRadius="12dp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmPayment"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3"
                android:text="Konfirmasi Bayar"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                app:backgroundTint="#059669"
                app:cornerRadius="12dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>