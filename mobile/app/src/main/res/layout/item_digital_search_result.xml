<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvItemCategoryBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PULSA"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#3E24E2"
                    android:background="@drawable/bg_role_badge_owner"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvItemCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kode: TREG10"
                    android:textSize="11sp"
                    android:textColor="#64748B"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvItemName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="[Pulsa Telkomsel] Pulsa 10,000"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tvItemSellingPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 12.000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#00A86B" />

            <TextView
                android:id="@+id/tvItemCostPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Modal: Rp 10.200"
                android:textSize="10sp"
                android:textColor="#94A3B8" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
