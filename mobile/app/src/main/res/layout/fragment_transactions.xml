<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <!-- Top Header Bar (Matching Image #2) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@android:color/white"
        android:paddingHorizontal="16dp"
        android:elevation="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBackTransactions"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="centerInside"
            app:tint="#0F172A"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daftar Belanja"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageButton
            android:id="@+id/btnAddNewPurchase"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_add_white"
            android:scaleType="centerInside"
            app:tint="#0F172A"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Sub-Tabs Navigation: Draft, Dipesan, Selesai, Kasir (Matching Image #2) -->
    <LinearLayout
        android:id="@+id/subTabsBar"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@android:color/white"
        android:gravity="center_vertical"
        android:elevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Tab 1: Draft -->
        <LinearLayout
            android:id="@+id/tabDraft"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvTabDraftLabel"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Draft"
                android:textColor="#3E24E2"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/indicatorDraft"
                android:layout_width="48dp"
                android:layout_height="3dp"
                android:background="#3E24E2" />
        </LinearLayout>

        <!-- Tab 2: Dipesan -->
        <LinearLayout
            android:id="@+id/tabDipesan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvTabDipesanLabel"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Dipesan"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <View
                android:id="@+id/indicatorDipesan"
                android:layout_width="48dp"
                android:layout_height="3dp"
                android:background="#3E24E2"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- Tab 3: Selesai -->
        <LinearLayout
            android:id="@+id/tabSelesai"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvTabSelesaiLabel"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Selesai"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <View
                android:id="@+id/indicatorSelesai"
                android:layout_width="48dp"
                android:layout_height="3dp"
                android:background="#3E24E2"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- Tab 4: Kasir -->
        <LinearLayout
            android:id="@+id/tabKasir"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvTabKasirLabel"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Kasir"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <View
                android:id="@+id/indicatorKasir"
                android:layout_width="48dp"
                android:layout_height="3dp"
                android:background="#3E24E2"
                android:visibility="invisible" />
        </LinearLayout>

    </LinearLayout>

    <!-- Content Area: RecyclerViews -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/subTabsBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 1. Purchase Orders List (For Draft, Dipesan, Selesai) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPurchaseOrdersList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            tools:listitem="@layout/item_purchase_order" />

        <!-- 2. Cashier Transactions List (For Kasir tab) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCashierTransactionsList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:listitem="@layout/item_transaction_history" />

        <!-- Empty State Message -->
        <TextView
            android:id="@+id/tvEmptyMessage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Tidak ada data belanja / transaksi pada kategori ini."
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:visibility="gone" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
