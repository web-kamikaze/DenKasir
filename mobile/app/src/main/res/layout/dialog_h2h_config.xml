<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Konfigurasi Server Pulsa &amp; PPOB"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Atur integrasi API H2H OtomaX/IRS dan SMS Center cadangan tanpa kuota"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="2dp" />

        <!-- ========================================== -->
        <!-- 1. PILIHAN METODE TRANSAKSI GATEWAY        -->
        <!-- ========================================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Metode Transaksi Gateway"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#334155" />

        <RadioGroup
            android:id="@+id/rgTrxMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbModeApi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="API H2H (Jalur Internet Cepat - OtomaX / IRS)"
                android:textSize="13sp"
                android:textColor="#0F172A"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbModeSms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SMS Center (Jalur SMS Seluler Tanpa Kuota Data)"
                android:textSize="13sp"
                android:textColor="#0F172A" />

            <RadioButton
                android:id="@+id/rbModeAuto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Otomatis (API H2H + Cadangan SMS Center saat Offline)"
                android:textSize="13sp"
                android:textColor="#0F172A" />
        </RadioGroup>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E2E8F0"
            android:layout_marginVertical="14dp" />

        <!-- ========================================== -->
        <!-- 2. KREDENSIAL API H2H                      -->
        <!-- ========================================== -->
        <LinearLayout
            android:id="@+id/layoutApiCredentials"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kredensial API H2H Server"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#3E24E2" />

            <!-- URL API H2H -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="URL Endpoint API H2H"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#334155" />

            <EditText
                android:id="@+id/etH2hApiUrl"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_box"
                android:paddingHorizontal="14dp"
                android:hint="https://api.distributor-pulsa.com/v1/trx"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:singleLine="true" />

            <!-- API Key -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="API Key / Token Rahasia"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#334155" />

            <EditText
                android:id="@+id/etH2hApiKey"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_box"
                android:paddingHorizontal="14dp"
                android:hint="Contoh: sec_live_99882244aaccbb"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Member ID & PIN (Berlaku untuk API H2H & SMS Center) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Member / Outlet ID"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#334155" />

                <EditText
                    android:id="@+id/etH2hMemberId"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input_box"
                    android:paddingHorizontal="14dp"
                    android:hint="MB-08992"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:singleLine="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PIN Transaksi"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#334155" />

                <EditText
                    android:id="@+id/etH2hPin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input_box"
                    android:paddingHorizontal="14dp"
                    android:hint="1234"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:inputType="numberPassword"
                    android:singleLine="true" />
            
                <TextView
                    android:id="@+id/tvPinHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="*Wajib: PIN otomatis disertakan ke perintah SMS Center"
                    android:textSize="10.5sp"
                    android:textColor="#3E24E2" />
            </LinearLayout>
        </LinearLayout>

        <!-- Saldo Deposit Server -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Saldo Deposit Server Pulsa (Rp)"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#334155" />

        <EditText
            android:id="@+id/etH2hBalance"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_box"
            android:paddingHorizontal="14dp"
            android:hint="2500000"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:inputType="number"
            android:singleLine="true" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E2E8F0"
            android:layout_marginVertical="14dp" />

        <!-- ========================================== -->
        <!-- 3. KONFIGURASI SMS CENTER DISTRIBUTOR     -->
        <!-- ========================================== -->
        <LinearLayout
            android:id="@+id/layoutSmsCenterSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daftar Nomor SMS Center Distributor"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#3E24E2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bisa didaftarkan lebih dari 1 nomor center (Telkomsel, Indosat, XL, Tri, dsb.)"
                android:textSize="11sp"
                android:textColor="#64748B"
                android:layout_marginTop="2dp" />

            <!-- Input Tambah Nomor SMS Center Baru -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <EditText
                    android:id="@+id/etNewSmsCenter"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_box"
                    android:paddingHorizontal="14dp"
                    android:hint="Contoh: 081234567890"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:inputType="phone"
                    android:singleLine="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddSmsCenter"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:text="+ Tambah"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    app:backgroundTint="#3E24E2"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- Dynamic List Nomor SMS Center yang Sudah Ditambahkan -->
            <LinearLayout
                android:id="@+id/layoutSmsCenterList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/tvEmptySmsCenter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Belum ada nomor SMS Center yang ditambahkan"
                android:textSize="12sp"
                android:textColor="#94A3B8"
                android:paddingVertical="8dp" />

            <!-- Format Perintah SMS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Format Perintah SMS Transaksi"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#334155" />

            <RadioGroup
                android:id="@+id/rgSmsFormat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbFormatDot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="[KODE].[TUJUAN].[PIN] (Default OtomaX / IRS)"
                    android:textSize="12sp"
                    android:textColor="#0F172A"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbFormatHash"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="[KODE]#[TUJUAN]#[PIN] (Pemisah Pagar)"
                    android:textSize="12sp"
                    android:textColor="#0F172A" />

                <RadioButton
                    android:id="@+id/rbFormatSpace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BELI [KODE] [TUJUAN] [PIN] (Pemisah Spasi)"
                    android:textSize="12sp"
                    android:textColor="#0F172A" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F1F5F9"
                android:padding="10dp"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pratinjau Perintah SMS yang Akan Terkirim:"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#475569" />

                <TextView
                    android:id="@+id/tvSmsFormatPreview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="S10.081234567890.1234"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#3E24E2"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- ========================================== -->
            <!-- PILIHAN KARTU SIM (DUAL SIM SUPPORT)       -->
            <!-- ========================================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Pilihan Kartu SIM Pengirim (Dual SIM)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#334155" />

            <TextView
                android:id="@+id/tvDetectedSimInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mendeteksi kartu SIM..."
                android:textSize="11sp"
                android:textColor="#64748B"
                android:layout_marginTop="2dp" />

            <RadioGroup
                android:id="@+id/rgSimSelection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbSimDefault"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Otomatis (Ikuti Pengaturan Bawaan HP)"
                    android:textSize="12sp"
                    android:textColor="#0F172A"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbSim1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SIM 1"
                    android:textSize="12sp"
                    android:textColor="#0F172A" />

                <RadioButton
                    android:id="@+id/rbSim2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SIM 2"
                    android:textSize="12sp"
                    android:textColor="#0F172A" />
            </RadioGroup>

            <!-- Mode Kirim Otomatis (Direct SMS) -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchAutoSendSms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Kirim SMS Otomatis di Latar Belakang (Direct SMS)"
                android:textSize="12sp"
                android:textColor="#0F172A"
                android:checked="true" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E2E8F0"
            android:layout_marginVertical="14dp" />

        <!-- ========================================== -->
        <!-- 4. RUTE MULTI-DISTRIBUTOR KHUSUS           -->
        <!-- ========================================== -->
        <LinearLayout
            android:id="@+id/layoutMultiDistributorSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rute Multi-Distributor Khusus"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#3E24E2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pisahkan SMS Center &amp; PIN per kategori (Pulsa/Data/PLN)"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddDistributor"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="+ Tambah Rute"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    app:backgroundTint="#3E24E2"
                    app:cornerRadius="10dp" />
            </LinearLayout>

            <!-- Dynamic List Distributor Cards -->
            <LinearLayout
                android:id="@+id/layoutDistributorsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/tvEmptyDistributors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Belum ada rute khusus distributor. Transaksi akan menggunakan SMS Center &amp; PIN default di atas."
                android:textSize="12sp"
                android:textColor="#94A3B8"
                android:paddingVertical="8dp" />
        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelH2h"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Batal"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                app:backgroundTint="@color/purple_button_light"
                app:cornerRadius="12dp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveH2h"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3"
                android:text="Simpan Konfigurasi"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                app:backgroundTint="#3E24E2"
                app:cornerRadius="12dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
