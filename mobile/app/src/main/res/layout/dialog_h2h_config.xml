<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Konfigurasi API Server Pulsa H2H"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hubungkan DenKasir ke Gateway Distributor Pulsa &amp; PPOB OtomaX / IRS"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="2dp" />

        <!-- URL API H2H -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="URL Endpoint API H2H"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#334155" />

        <EditText
            android:id="@+id/etH2hApiUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_box"
            android:paddingHorizontal="14dp"
            android:hint="https://api.distributor-pulsa.com/v1/trx"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:singleLine="true" />

        <!-- API Key -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="API Key / Token Rahasia"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#334155" />

        <EditText
            android:id="@+id/etH2hApiKey"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_box"
            android:paddingHorizontal="14dp"
            android:hint="Contoh: sec_live_99882244aaccbb"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:singleLine="true" />

        <!-- Member ID & PIN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Member / Outlet ID"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#334155" />

                <EditText
                    android:id="@+id/etH2hMemberId"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input_box"
                    android:paddingHorizontal="14dp"
                    android:hint="MB-08992"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:singleLine="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PIN Transaksi"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#334155" />

                <EditText
                    android:id="@+id/etH2hPin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input_box"
                    android:paddingHorizontal="14dp"
                    android:hint="1234"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:inputType="numberPassword"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- Saldo Deposit Server -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Saldo Deposit Server Pulsa (Rp)"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#334155" />

        <EditText
            android:id="@+id/etH2hBalance"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_box"
            android:paddingHorizontal="14dp"
            android:hint="2500000"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:inputType="number"
            android:singleLine="true" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelH2h"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Batal"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                app:backgroundTint="@color/purple_button_light"
                app:cornerRadius="12dp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveH2h"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3"
                android:text="Simpan Konfigurasi"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                app:backgroundTint="#3E24E2"
                app:cornerRadius="12dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
